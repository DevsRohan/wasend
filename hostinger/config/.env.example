# ---------------------------------------------------------------------
# Wasend - Environment Overrides (file-based)
# Copy this to .env and edit. Anything set here overrides DB-stored
# settings ONLY for keys that aren't in the settings table.
# ---------------------------------------------------------------------

# App
APP_NAME=Wasend
APP_ENV=production
APP_DEBUG=0
APP_URL=https://yourdomain.com

# 32+ char random string. Used to encrypt secrets stored in DB.
APP_KEY=replace-with-32-byte-random-secret-please

# MySQL (Hostinger shared hosting)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wasend_crm
DB_USER=wasend_user
DB_PASS=strong-password-here
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------
# OPTIONAL: Bypass DB-stored encrypted secrets via direct env values.
#
# If APP_KEY ever changes after secrets were saved through the UI, the
# encrypted DB values become unreadable and webhooks/AI break silently.
# Setting these env vars makes the system read them directly, bypassing
# DB encryption entirely. Recommended for production stability.
# ---------------------------------------------------------------------
# WEBHOOK_SECRET=must-match-HF-Space-WEBHOOK_SECRET-exactly
# NODE_API_KEY=must-match-HF-Space-NODE_API_KEY-exactly
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
