# ---------------------------------------------------------------------
# Wasend Engine - Environment Variables
# Configure these as Space "Secrets" in Hugging Face Spaces UI
# ---------------------------------------------------------------------

# REQUIRED — must match the value set in PHP settings (node_api_key)
NODE_API_KEY=replace-with-strong-bearer-key

# REQUIRED — must match PHP settings (webhook_secret). HMAC-SHA256.
WEBHOOK_SECRET=replace-with-strong-hmac-secret

# REQUIRED — full URL to PHP webhook receiver
WEBHOOK_URL=https://yourdomain.com/webhook.php

# CORS allowlist for browser Socket.io / direct PHP origin
ALLOWED_ORIGIN=https://yourdomain.com

# Optional: comma-separated list if multiple
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Port (HF Spaces requires 7860)
PORT=7860

# Persistent data dir (HF Spaces persistent storage mount)
DATA_DIR=/data

# Behavior tuning (optional, sensible defaults)
PUPPETEER_HEADLESS=true
SESSION_BACKUP_INTERVAL_MIN=30
WEBHOOK_RETRY_MAX=5
WEBHOOK_RETRY_BASE_MS=2000
DAILY_VALIDATE_LIMIT=400
